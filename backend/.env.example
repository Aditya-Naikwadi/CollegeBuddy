# Backend Environment Configuration Example
# Copy this file to .env in local development: cp .env.example .env

# Server Settings
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Admin Security Token
ADMIN_TOKEN=college-admin-supersecret-2026

# AI / Retrieval Threshold (Minimum hybrid similarity score to accept an answer)
SIMILARITY_THRESHOLD=0.35

# Optional Anthropic LLM Integration
# If left empty, chatbot returns top retrieved FAQ answer directly without LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
